{erl_opts, [debug_info]}.

%% OTP 29 兼容：meck 的 rebar.config 设 warnings_as_errors，catch
%% 弃用被 OTP 29 升级为错误，覆盖 meck 的 erl_opts 抑制该警告。
{overrides, [
    {override, meck, [{erl_opts, [nowarn_deprecated_catch]}]}
]}.

%% JSON 编解码使用 OTP 27+ 内置 json 模块，运行时零第三方依赖。
%% inets/ssl/crypto/public_key 为 OTP 自带，无需声明为 deps。
{deps, []}.

{profiles, [
    {test, [
        {deps, [{meck, "1.2.0"}]},
        {erl_opts, [debug_info, nowarn_export_all, nowarn_deprecated_catch]}
    ]}
]}.

{project_plugins, [rebar3_hex, rebar3_ex_doc]}.

{hex, [
    {doc, ex_doc},
    {name, erlang_pay},
    {description, "Pure-Erlang payment gateway library (Alipay / WeChat Pay v3 / Stripe)"},
    {licenses, ["Apache-2.0"]},
    {links, [
        {"GitHub", "https://github.com/imboy-pub/erlang_pay"},
        {"Gitee",  "https://gitee.com/imboy-pub/erlang_pay"}
    ]},
    {build_tools, ["rebar3"]},
    {include_files, ["include", "src", "priv", "LICENSE", "README.md", "CHANGELOG.md"]}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/imboy-pub/erlang_pay">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>}
]}.

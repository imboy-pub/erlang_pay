{erl_opts, [debug_info]}.

%% jsone: JSON 编解码（与 imboy 主仓一致，轻量无传递依赖）。
%% inets/ssl/crypto/public_key 为 OTP 自带，无需声明为 deps。
{deps, [
    {jsone, "1.8.1"}
]}.

{profiles, [
    {test, [
        {deps, [{meck, "0.9.2"}]},
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

{project_plugins, [rebar3_hex, rebar3_ex_doc]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [
    {source_url, <<"https://github.com/imboy-pub/erlang_pay">>},
    {extras, [<<"README.md">>, <<"CHANGELOG.md">>, <<"LICENSE">>]},
    {main, <<"README.md">>}
]}.
